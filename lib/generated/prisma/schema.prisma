generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  user
  admin
}

enum CertificationStatus {
  PENDING
  VALID
  EXPIRED
  REVOKED
}

enum ValidationStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                      String                   @id
  name                    String
  email                   String
  emailVerified           Boolean                  @default(false)
  image                   String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  role                    String                   @default("user")
  banned                  Boolean?                 @default(false)
  banReason               String?
  banExpires              DateTime?
  sessions                Session[]
  accounts                Account[]
  reviews                 Review[]
  halalValidations        HalalValidation[]
  destinationInteractions DestinationInteraction[]
  itineraries             Itinerary[]

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum CategoryType {
  DESTINATION
  UMKM
  ACCOMMODATION
}

model Category {
  id          String       @id @default(uuid())
  name        String
  slug        String
  type        CategoryType @default(DESTINATION)
  description String?
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  destinations Destination[]
  umkms        Umkm[]

  @@unique([slug, type])
  @@map("categories")
}

model Destination {
  id             String           @id @default(uuid())
  categoryId     String           @map("category_id")
  name           String
  slug           String           @unique
  description    Json?
  address        String?
  city           String?
  province       String?
  latitude       Decimal?         @db.Decimal(10, 7)
  longitude      Decimal?         @db.Decimal(10, 7)
  status         ValidationStatus @default(PENDING)
  rating         Float?           @default(0)
  reviewCount    Int?             @default(0) @map("review_count")
  openingHours   Json?            @map("opening_hours")
  halalScore     Int?             @map("halal_score")
  validatedScore Int?             @map("validated_score")
  categoryScores Json?            @map("category_scores")
  externalId     String?          @map("external_id")
  externalSource String?          @map("external_source")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  category                   Category                   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images                     DestinationImage[]
  reviews                    Review[]
  umkms                      Umkm[]
  destinationHalalFacilities DestinationHalalFacility[]
  halalValidations           HalalValidation[]
  interactions               DestinationInteraction[]
  trends                     DestinationTrend[]
  itineraryItems             ItineraryItem[]

  @@index([categoryId])
  @@index([externalId])
  @@map("destinations")
}

model Accommodation {
  id               String   @id @default(uuid())
  name             String
  slug             String   @unique
  description      Json?
  address          String?
  city             String?
  province         String?
  latitude         Decimal? @db.Decimal(10, 7)
  longitude        Decimal? @db.Decimal(10, 7)
  phone            String?
  website          String?
  rating           Float?   @default(0)
  reviewCount      Int?     @default(0) @map("review_count")
  validationStatus String   @default("PENDING") @map("validation_status")
  surveyorNote     String?  @map("surveyor_note")
  validatedScore   Int?     @map("validated_score")
  externalId       String?  @map("external_id")
  externalSource   String?  @map("external_source")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  images     AccommodationImage[]
  reviews    Review[]
  facilities AccommodationHalalFacility[]

  @@index([externalId])
  @@map("accommodations")
}

model AccommodationImage {
  id              String   @id @default(uuid())
  accommodationId String   @map("accommodation_id")
  imageUrl        String   @map("image_url")
  caption         String?
  isPrimary       Boolean  @default(false) @map("is_primary")
  createdAt       DateTime @default(now()) @map("created_at")

  accommodation Accommodation @relation(fields: [accommodationId], references: [id], onDelete: Cascade)

  @@index([accommodationId])
  @@map("accommodation_images")
}

model AccommodationHalalFacility {
  id              String  @id @default(uuid())
  accommodationId String  @map("accommodation_id")
  facilityId      String  @map("facility_id")
  name            String?

  accommodation Accommodation @relation(fields: [accommodationId], references: [id], onDelete: Cascade)
  facility      HalalFacility @relation(fields: [facilityId], references: [id], onDelete: Restrict)

  @@index([accommodationId])
  @@index([facilityId])
  @@map("accommodation_halal_facilities")
}

model DestinationImage {
  id            String   @id @default(uuid())
  destinationId String   @map("destination_id")
  imageUrl      String   @map("image_url")
  caption       String?
  isPrimary     Boolean  @default(false) @map("is_primary")
  createdAt     DateTime @default(now()) @map("created_at")

  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@index([destinationId])
  @@map("destination_images")
}

model DestinationHalalFacility {
  id            String  @id @default(uuid())
  destinationId String  @map("destination_id")
  facilityId    String  @map("facility_id")
  latitude      Float?
  longitude     Float?
  name          String?

  destination Destination                   @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  facility    HalalFacility                 @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  evidences   DestinationFacilityEvidence[]

  @@index([destinationId])
  @@index([facilityId])
  @@map("destination_halal_facilities")
}

model DestinationFacilityEvidence {
  id             String   @id @default(uuid())
  destFacilityId String   @map("dest_facility_id")
  imageUrl       String   @map("image_url")
  createdAt      DateTime @default(now()) @map("created_at")

  destFacility DestinationHalalFacility @relation(fields: [destFacilityId], references: [id], onDelete: Cascade)

  @@index([destFacilityId])
  @@map("destination_facility_evidences")
}

model HalalFacility {
  id             String   @id @default(uuid())
  name           String
  description    String?
  facilityType   String?  @map("facility_type")
  externalId     String?  @map("external_id")
  externalSource String?  @map("external_source")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  weight         Int?     @default(0)
  maxDistance    Float    @default(5.0) @map("max_distance")

  destinationHalalFacilities   DestinationHalalFacility[]
  umkmHalalFacilities          UmkmHalalFacility[]
  accommodationHalalFacilities AccommodationHalalFacility[]

  @@index([externalId])
  @@map("halal_facilities")
}

model Review {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  destinationId   String?  @map("destination_id")
  umkmId          String?  @map("umkm_id")
  accommodationId String?  @map("accommodation_id")
  rating          Int
  comment         String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination   Destination?     @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  umkm          Umkm?            @relation(fields: [umkmId], references: [id], onDelete: Cascade)
  accommodation Accommodation?   @relation(fields: [accommodationId], references: [id], onDelete: Cascade)
  sentiment     ReviewSentiment?

  @@index([userId])
  @@index([destinationId])
  @@index([umkmId])
  @@index([accommodationId])
  @@map("reviews")
}

enum InteractionType {
  VIEW
  SEARCH
  CLICK
  SAVE
  SHARE
  ROUTE
}

enum SentimentLabel {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

model DestinationInteraction {
  id            String          @id @default(uuid())
  destinationId String          @map("destination_id")
  userId        String?         @map("user_id")
  type          InteractionType
  keyword       String?
  source        String?
  metadata      Json?
  createdAt     DateTime        @default(now()) @map("created_at")

  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([destinationId, type, createdAt])
  @@index([userId])
  @@index([createdAt])
  @@map("destination_interactions")
}

model DestinationTrend {
  id            String   @id @default(uuid())
  destinationId String   @map("destination_id")
  period        String
  periodStart   DateTime @map("period_start")
  viewCount     Int      @default(0) @map("view_count")
  searchCount   Int      @default(0) @map("search_count")
  clickCount    Int      @default(0) @map("click_count")
  saveCount     Int      @default(0) @map("save_count")
  shareCount    Int      @default(0) @map("share_count")
  routeCount    Int      @default(0) @map("route_count")
  trendScore    Float    @default(0) @map("trend_score")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@unique([destinationId, period, periodStart])
  @@index([period, periodStart, trendScore])
  @@map("destination_trends")
}

model ReviewSentiment {
  id         String         @id @default(uuid())
  reviewId   String         @unique @map("review_id")
  label      SentimentLabel
  score      Float
  keywords   String[]
  summary    String?
  analyzedAt DateTime       @default(now()) @map("analyzed_at")

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([label])
  @@map("review_sentiments")
}

model Itinerary {
  id        String    @id @default(uuid())
  userId    String?   @map("user_id")
  title     String
  city      String?
  province  String?
  startDate DateTime? @map("start_date")
  endDate   DateTime? @map("end_date")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user  User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  items ItineraryItem[]

  @@index([userId])
  @@map("itineraries")
}

model ItineraryItem {
  id            String  @id @default(uuid())
  itineraryId   String  @map("itinerary_id")
  destinationId String  @map("destination_id")
  dayNumber     Int     @map("day_number")
  orderIndex    Int     @map("order_index")
  estimatedTime Int?    @map("estimated_time")
  notes         String?

  itinerary   Itinerary   @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@index([itineraryId])
  @@index([destinationId])
  @@map("itinerary_items")
}

model HalalReadinessScore {
  id                   String   @id @default(uuid())
  regionName           String   @map("region_name")
  regionType           String   @map("region_type")
  destinationCount     Int      @default(0) @map("destination_count")
  halalFacilityScore   Float    @default(0) @map("halal_facility_score")
  halalFoodScore       Float    @default(0) @map("halal_food_score")
  worshipAccessScore   Float    @default(0) @map("worship_access_score")
  transportAccessScore Float    @default(0) @map("transport_access_score")
  totalScore           Float    @default(0) @map("total_score")
  recommendation       String?
  calculatedAt         DateTime @default(now()) @map("calculated_at")

  @@index([regionName, regionType])
  @@map("halal_readiness_scores")
}

model Umkm {
  id               String   @id @default(uuid())
  destinationId    String?  @map("destination_id")
  categoryId       String?  @map("category_id")
  name             String
  slug             String   @unique
  description      String?
  address          String?
  phone            String?
  latitude         Decimal? @db.Decimal(10, 7)
  longitude        Decimal? @db.Decimal(10, 7)
  rating           Float?   @default(0)
  reviewCount      Int?     @default(0) @map("review_count")
  openingHours     Json?    @map("opening_hours")
  externalId       String?  @map("external_id")
  externalSource   String?  @map("external_source")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  owner            String
  validationStatus String   @default("PENDING") @map("validation_status")
  surveyorNote     String?  @map("surveyor_note")

  destination         Destination?         @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  category            Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images              UmkmImage[]
  reviews             Review[]
  certifications      HalalCertification[]
  umkmHalalFacilities UmkmHalalFacility[]

  @@index([destinationId])
  @@index([categoryId])
  @@index([externalId])
  @@map("umkms")
}

model UmkmImage {
  id        String   @id @default(uuid())
  umkmId    String   @map("umkm_id")
  imageUrl  String   @map("image_url")
  caption   String?
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")

  umkm Umkm @relation(fields: [umkmId], references: [id], onDelete: Cascade)

  @@index([umkmId])
  @@map("umkm_images")
}

model UmkmHalalFacility {
  id         String  @id @default(uuid())
  umkmId     String  @map("umkm_id")
  facilityId String  @map("facility_id")
  name       String?

  umkm     Umkm          @relation(fields: [umkmId], references: [id], onDelete: Cascade)
  facility HalalFacility @relation(fields: [facilityId], references: [id], onDelete: Restrict)

  @@index([umkmId])
  @@index([facilityId])
  @@map("umkm_halal_facilities")
}

model HalalCertification {
  id            String              @id @default(uuid())
  umkmId        String              @map("umkm_id")
  certificateNo String?             @unique @map("certificate_no")
  issuer        String?
  issuedAt      DateTime?           @map("issued_at")
  expiredAt     DateTime?           @map("expired_at")
  status        CertificationStatus @default(PENDING)
  documentUrl   String?             @map("document_url")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  notes         String?

  umkm        Umkm              @relation(fields: [umkmId], references: [id], onDelete: Cascade)
  validations HalalValidation[]

  @@index([umkmId])
  @@map("halal_certifications")
}

model HalalValidation {
  id              String           @id @default(uuid())
  certificationId String?          @map("certification_id")
  destinationId   String?          @map("destination_id")
  validatorId     String?          @map("validator_id")
  status          ValidationStatus @default(PENDING)
  adminScore      Int?             @map("admin_score")
  categoryScores  Json?            @map("category_scores")
  notes           String?
  validatedAt     DateTime?        @map("validated_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  certification HalalCertification?  @relation(fields: [certificationId], references: [id], onDelete: Cascade)
  destination   Destination?         @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  validator     User?                @relation(fields: [validatorId], references: [id], onDelete: SetNull)
  evidences     ValidationEvidence[]

  @@index([certificationId])
  @@index([destinationId])
  @@index([validatorId])
  @@map("halal_validations")
}

model ValidationEvidence {
  id           String   @id @default(uuid())
  validationId String   @map("validation_id")
  fileUrl      String   @map("file_url")
  description  String?
  createdAt    DateTime @default(now()) @map("created_at")

  validation HalalValidation @relation(fields: [validationId], references: [id], onDelete: Cascade)

  @@index([validationId])
  @@map("validation_evidences")
}

model ExternalPlaceSource {
  id            String   @id @default(uuid())
  entityType    String   @map("entity_type") // destination, umkm, facility
  entityId      String?  @map("entity_id")
  vendor        String
  vendorPlaceId String   @map("vendor_place_id")
  rawPayload    Json     @map("raw_payload")
  fetchedAt     DateTime @default(now()) @map("fetched_at")

  @@unique([vendor, vendorPlaceId])
  @@map("external_place_sources")
}
