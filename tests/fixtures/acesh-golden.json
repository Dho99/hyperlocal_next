{
  "title": "ACES-H Golden Dataset — SAFAR lampiran penelitian",
  "version": "ACES-H-1.0",
  "mappingWorkflow": { "PENDING": "Assessment Submitted", "VERIFIED": "Verified" },
  "scoringPolicy": {
    "indicatorToScore": "value * 25, value 0-4 int",
    "groupScore": "round1(sum(weight*value*25)/sum(weight))",
    "acesScore": "round1(sum(groupScore*dimWeight)) clamp 0-100",
    "hyperlocalScore": "round1(sum(groupScore*dimWeight)) clamp 0-100",
    "baseScore": "round1(clamp(aces*0.65 + hyperlocal*0.35)) from already-rounded aces/hyperlocal",
    "evidenceFactor": "round3(0.70 + 0.30*confidence/100) clamp 0.70-1.00",
    "verifiedScore": "round1(clamp(base*evidenceFactor)), null when PENDING",
    "classification": "SANGAT_SIAP>=85, SIAP>=70, BERKEMBANG>=55, PERLU_PENGEMBANGAN>=40, else BELUM_SIAP"
  },
  "officialSimulation": {
    "aces": { "ACCESS": 75, "COMMUNICATION": 50, "ENVIRONMENT": 50, "SERVICES": 76.3 },
    "hyperlocal": { "SPATIAL_ACCESSIBILITY": 68.8, "FUNCTIONAL_AVAILABILITY": 50, "HALAL_ASSURANCE": 58.8, "ECOSYSTEM_CONNECTIVITY": 60, "EMBEDDEDNESS_CONTINUITY": 56.3 },
    "acesScore": 66.8,
    "hyperlocalScore": 59.5,
    "baseScore": 64.2,
    "confidence": 69,
    "evidenceFactor": 0.907,
    "verifiedScore": 58.2,
    "classification": "BERKEMBANG",
    "verificationStatus": "VERIFIED"
  },
  "benchmarks": [
    {
      "id": "ACESH-001",
      "label": "Controlled 3 komponen 80/70/90 bobot 40/30/30",
      "input": { "acesScore": 80, "hyperlocalScore": 80, "evidenceConfidenceScore": 100 },
      "note": "aces=hyper=80 → base 80, factor 1.0 → verified 80 (TG3 ACESH-CALC-001)",
      "expected": { "baseScore": 80, "evidenceFactor": 1, "verifiedScore": 80 }
    },
    {
      "id": "ACESH-002",
      "label": "Official golden 66.8/59.5/69 → 58.2 BERKEMBANG (TG3 ACESH-CALC-002)",
      "input": { "acesScore": 66.8125, "hyperlocalScore": 59.5, "evidenceConfidenceScore": 69 },
      "expected": { "acesScore": 66.8, "hyperlocalScore": 59.5, "baseScore": 64.2, "evidenceFactor": 0.907, "verifiedScore": 58.2, "classification": "BERKEMBANG", "verificationStatus": "VERIFIED" }
    },
    {
      "id": "ACESH-003",
      "label": "Semua indikator 0 → 0 BELUM_SIAP (TG4 boundary min)",
      "input": { "acesScore": 0, "hyperlocalScore": 0, "evidenceConfidenceScore": 0 },
      "expected": { "baseScore": 0, "evidenceFactor": 0.7, "verifiedScore": 0, "classification": "BELUM_SIAP" }
    },
    {
      "id": "ACESH-EDGE-004",
      "label": "Edge A65 H35 conf100 dinamis base0.5/0.5 factor0.8/0.2 → base60 factor0.9 verified54",
      "input": { "acesScore": 80, "hyperlocalScore": 40, "evidenceConfidenceScore": 50 },
      "overrides": { "baseAces": 0.5, "baseHyperlocal": 0.5, "evidenceFactorBase": 0.8, "evidenceFactorRange": 0.2 },
      "expected": { "baseScore": 60, "evidenceFactor": 0.9, "verifiedScore": 54 }
    }
  ],
  "regression": {
    "id": "ACESH-REGRESSION-001",
    "label": "Config 65/35 → 50/50 ubah baseScore deterministik (TG1)",
    "from": { "baseAces": 0.65, "baseHyperlocal": 0.35 },
    "to": { "baseAces": 0.5, "baseHyperlocal": 0.5 },
    "given": { "acesScore": 66.8, "hyperlocalScore": 59.5 },
    "expected": { "fromBase": 64.2, "toBase": 63.2 }
  }
}
