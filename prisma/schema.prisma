generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  user
  admin
  umkm_owner
}

enum CertificationStatus {
  PENDING
  VALID
  EXPIRED
  REVOKED
}

enum ValidationStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id               String            @id
  name             String
  email            String
  emailVerified    Boolean           @default(false)
  image            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  role             String            @default("user")
  banned           Boolean?          @default(false)
  banReason        String?
  banExpires       DateTime?
  sessions         Session[]
  accounts         Account[]
  reviews          Review[]
  umkms            Umkm[]
  halalValidations HalalValidation[]

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Category {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  destinations Destination[]
  umkms        Umkm[]

  @@map("categories")
}

model Destination {
  id          String   @id @default(uuid())
  categoryId  String   @map("category_id")
  name        String
  slug        String   @unique
  description String?
  address     String?
  city        String?
  province    String?
  latitude    Decimal? @db.Decimal(10, 7)
  longitude   Decimal? @db.Decimal(10, 7)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  category        Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images          DestinationImage[]
  halalFacilities HalalFacility[]
  reviews         Review[]
  umkms           Umkm[]

  @@index([categoryId])
  @@map("destinations")
}

model DestinationImage {
  id            String   @id @default(uuid())
  destinationId String   @map("destination_id")
  imageUrl      String   @map("image_url")
  caption       String?
  isPrimary     Boolean  @default(false) @map("is_primary")
  createdAt     DateTime @default(now()) @map("created_at")

  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@index([destinationId])
  @@map("destination_images")
}

model HalalFacility {
  id            String   @id @default(uuid())
  destinationId String   @map("destination_id")
  name          String
  description   String?
  facilityType  String?  @map("facility_type")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@index([destinationId])
  @@map("halal_facilities")
}

model Review {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  destinationId String?  @map("destination_id")
  umkmId        String?  @map("umkm_id")
  rating        Int
  comment       String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination Destination? @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  umkm        Umkm?        @relation(fields: [umkmId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([destinationId])
  @@index([umkmId])
  @@map("reviews")
}

model Umkm {
  id            String   @id @default(uuid())
  ownerId       String?  @map("owner_id")
  destinationId String?  @map("destination_id")
  categoryId    String?  @map("category_id")
  name          String
  slug          String   @unique
  description   String?
  address       String?
  phone         String?
  latitude      Decimal? @db.Decimal(10, 7)
  longitude     Decimal? @db.Decimal(10, 7)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  owner          User?                @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  destination    Destination?         @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  category       Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images         UmkmImage[]
  reviews        Review[]
  certifications HalalCertification[]

  @@index([ownerId])
  @@index([destinationId])
  @@index([categoryId])
  @@map("umkms")
}

model UmkmImage {
  id        String   @id @default(uuid())
  umkmId    String   @map("umkm_id")
  imageUrl  String   @map("image_url")
  caption   String?
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")

  umkm Umkm @relation(fields: [umkmId], references: [id], onDelete: Cascade)

  @@index([umkmId])
  @@map("umkm_images")
}

model HalalCertification {
  id            String              @id @default(uuid())
  umkmId        String              @map("umkm_id")
  certificateNo String?             @unique @map("certificate_no")
  issuer        String?
  issuedAt      DateTime?           @map("issued_at")
  expiredAt     DateTime?           @map("expired_at")
  status        CertificationStatus @default(PENDING)
  documentUrl   String?             @map("document_url")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  umkm        Umkm              @relation(fields: [umkmId], references: [id], onDelete: Cascade)
  validations HalalValidation[]

  @@index([umkmId])
  @@map("halal_certifications")
}

model HalalValidation {
  id              String           @id @default(uuid())
  certificationId String           @map("certification_id")
  validatorId     String?          @map("validator_id")
  status          ValidationStatus @default(PENDING)
  notes           String?
  validatedAt     DateTime?        @map("validated_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  certification HalalCertification   @relation(fields: [certificationId], references: [id], onDelete: Cascade)
  validator     User?                @relation(fields: [validatorId], references: [id], onDelete: SetNull)
  evidences     ValidationEvidence[]

  @@index([certificationId])
  @@index([validatorId])
  @@map("halal_validations")
}

model ValidationEvidence {
  id           String   @id @default(uuid())
  validationId String   @map("validation_id")
  fileUrl      String   @map("file_url")
  description  String?
  createdAt    DateTime @default(now()) @map("created_at")

  validation HalalValidation @relation(fields: [validationId], references: [id], onDelete: Cascade)

  @@index([validationId])
  @@map("validation_evidences")
}
